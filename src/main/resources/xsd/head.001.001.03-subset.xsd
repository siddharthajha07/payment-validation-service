<?xml version="1.0" encoding="UTF-8"?>
<!--
    ISO 20022 Business Application Header (head.001.001.03) — SUBSET.

    This is a deliberately reduced schema covering only the header elements this service
    reads or validates. It is authored for this project rather than taken from the
    official ISO distribution: the full schema generates several hundred types, the great
    majority unused here, which makes the binding harder to review and to explain.

    Optional elements defined by ISO but not used by this service (MktPrctc, BizPrcgDt,
    CpyDplct, PssblDplct, Prty, Rltd) are omitted. A message carrying them would fail
    validation against this subset; that is an accepted, documented trade-off for a
    service whose counterparties send the message shape shown in the supplied samples.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.03"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:head.001.001.03"
           elementFormDefault="qualified">

    <!-- ============================= Simple types ============================= -->

    <xs:simpleType name="Max35Text">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="35"/>
        </xs:restriction>
    </xs:simpleType>

    <!--
        BIC. The strict ISO pattern is [A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3}){0,1},
        which requires exactly 8 or 11 characters with letters in positions 5-6.

        The supplied test data does not conform: BANKA000 has a digit in position 6, and
        CBANK0IPS is 9 characters. These are clearing-system test identifiers rather than
        registered BICs. The pattern is therefore relaxed to 8-11 uppercase alphanumerics
        so that genuine sample traffic is accepted. See ASSUMPTIONS.md; a production
        deployment would restore the strict ISO pattern.
    -->
    <xs:simpleType name="BicIdentifier">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z0-9]{8,11}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ============================ Complex types ============================ -->

    <xs:complexType name="FinancialInstitutionIdentification">
        <xs:sequence>
            <xs:element name="BICFI" type="BicIdentifier"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BranchAndFinancialInstitutionIdentification">
        <xs:sequence>
            <xs:element name="FinInstnId" type="FinancialInstitutionIdentification"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="Party">
        <xs:sequence>
            <xs:element name="FIId" type="BranchAndFinancialInstitutionIdentification"/>
        </xs:sequence>
    </xs:complexType>

    <!--
        The signature is accepted as opaque content. processContents="skip" instructs the
        validator not to look for a schema for the XML Digital Signature namespace: the
        signature's validity is a cryptographic question, not a structural one, and is
        answered by verifying it rather than by schema validation.
    -->
    <xs:complexType name="SignatureEnvelope">
        <xs:sequence>
            <xs:any namespace="##other" processContents="skip"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BusinessApplicationHeaderV03">
        <xs:sequence>
            <xs:element name="Fr" type="Party"/>
            <xs:element name="To" type="Party"/>
            <xs:element name="BizMsgIdr" type="Max35Text"/>
            <xs:element name="MsgDefIdr" type="Max35Text"/>
            <xs:element name="BizSvc" type="Max35Text" minOccurs="0"/>
            <xs:element name="CreDt" type="xs:dateTime"/>
            <xs:element name="Sgntr" type="SignatureEnvelope" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>
